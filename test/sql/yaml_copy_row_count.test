# name: test/sql/yaml_copy_row_count.test
# description: COPY keeps every row when the output spans several data chunks
# group: [sql]

require yaml

# DuckDB hands COPY 2048 rows per chunk. The document separator was skipped for the first row of EVERY chunk, not only
# the first row of the file, so that row merged into the previous document and read back as a duplicate key: lost.
statement ok
COPY (SELECT i AS id, 'row ' || i AS name FROM range(5000) t(i)) TO '__TEST_DIR__/rows_block.yaml' (FORMAT yaml);

query III
SELECT count(*), count(DISTINCT id), sum(id) FROM read_yaml('__TEST_DIR__/rows_block.yaml');
----
5000	5000	12497500

# Each row is its own document, so the separators count the rows.
query I
SELECT len(regexp_extract_all(content, '(?m)^---$')) FROM read_text('__TEST_DIR__/rows_block.yaml');
----
5000

# The boundary itself, with the row that was lost
query II
SELECT id, name FROM read_yaml('__TEST_DIR__/rows_block.yaml') WHERE id IN (2047, 2048, 4095, 4096) ORDER BY id;
----
2047	row 2047
2048	row 2048
4095	row 4095
4096	row 4096

# With several threads
statement ok
SET threads=4;

statement ok
COPY (SELECT i AS id FROM range(10000) t(i)) TO '__TEST_DIR__/rows_threads.yaml' (FORMAT yaml);

query II
SELECT count(*), count(DISTINCT id) FROM read_yaml('__TEST_DIR__/rows_threads.yaml');
----
10000	10000

# The other layouts have no separator, and must keep every row too
statement ok
COPY (SELECT i AS id FROM range(5000) t(i)) TO '__TEST_DIR__/rows_sequence.yaml' (FORMAT yaml, LAYOUT sequence);

query II
SELECT count(*), count(DISTINCT id) FROM read_yaml('__TEST_DIR__/rows_sequence.yaml');
----
5000	5000

statement ok
COPY (SELECT i AS id FROM range(5000) t(i)) TO '__TEST_DIR__/rows_flow.yaml' (FORMAT yaml, STYLE flow);

query II
SELECT count(*), count(DISTINCT id) FROM read_yaml('__TEST_DIR__/rows_flow.yaml');
----
5000	5000
